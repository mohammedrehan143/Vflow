# ==============================================================================
# VFlow Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MongoDB Atlas or Local MongoDB)
# Set USE_IN_MEMORY_DB=true to run zero-setup with an in-memory MongoDB instance
MONGODB_URI=mongodb://localhost:27017/vflow
USE_IN_MEMORY_DB=true

# Authentication & Security
JWT_SECRET=vflow_super_secure_jwt_dev_secret_key_change_in_production_32chars!
JWT_EXPIRES_IN=7d

# Supabase Auth & Storage (Optional: fallback auth provider works out of the box)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET_DOCS=provider-documents
SUPABASE_STORAGE_BUCKET_PHOTOS=listing-photos

# Razorpay Payments (Test Mode)
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
RAZORPAY_ROUTE_ENABLED=false

# Platform Business Configuration
PLATFORM_COMMISSION_PERCENTAGE=10
GST_PERCENTAGE=18
NEXT_DAY_CUTOFF_HOUR_UTC=18

# Frontend Environment Variables (apps/web/.env)
VITE_API_BASE_URL=/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_YourTestKeyHere
VITE_APP_TITLE=VFlow

# MapLibre GL JS Style URL (Configurable tile provider)
# Compatible options:
# - OpenFreeMap Liberty (free vector tiles, no API key): https://tiles.openfreemap.org/styles/liberty
# - MapLibre Demo Tiles: https://demotiles.maplibre.org/style.json
# - Carto Positron: https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# - Stadia Maps / MapTiler (requires API key): https://tiles.stadiamaps.com/styles/alidade_smooth.json?api_key=...
VITE_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
